<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/versionsFragment">

    <fragment
        android:id="@+id/versionsFragment"
        android:name="com.example.truthordare.VersionsFragment"
        android:label="fragment_versions"
        tools:layout="@layout/fragment_versions" >
        <action
            android:id="@+id/action_versionsFragment_to_playersFragment"
            app:destination="@id/playersFragment" />
    </fragment>
    <fragment
        android:id="@+id/playersFragment"
        android:name="com.example.truthordare.PlayersFragment"
        android:label="fragment_players"
        tools:layout="@layout/fragment_players" >
        <action
            android:id="@+id/action_playersFragment_to_versionsFragment"
            app:destination="@id/versionsFragment" />
    </fragment>
</navigation>